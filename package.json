{
  "name": "work-week-buddy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder --mac --dir",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:native": "vitest run src/native test/native --passWithNoTests",
    "selftest": "electron-vite build && electron out/main/index.js --selftest",
    "smoke": "electron-vite build && WWB_FAKE_NATIVE=1 electron . --smoke",
    "doctor": "node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/doctor.ts",
    "install:app": "bash scripts/install.sh",
    "bringup:cloud": "bash scripts/bringup-cloud.sh",
    "signing-cert": "bash scripts/make-signing-cert.sh",
    "launch-agent": "bash scripts/launch-agent.sh"
  },
  "dependencies": {
    "koffi": "3.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^9.20.0",
    "fast-check": "^4.1.1",
    "globals": "^16.0.0",
    "jsdom": "^29.1.1",
    "lucide-react": "1.33.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-activity-calendar": "3.2.1",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0",
    "vite": "7.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.124.0"
  }
}
